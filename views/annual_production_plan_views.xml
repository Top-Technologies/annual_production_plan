<odoo>
    <!-- Tree view -->
    <record id="view_annual_production_plan_tree" model="ir.ui.view">
        <field name="name">annual.production.plan.tree</field>
        <field name="model">annual.production.plan</field>
        <field name="arch" type="xml">
            <list string="Annual Production Plans">
                <field name="name"/>
                <field name="product_id"/>
                <field name="planned_by_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_planned_qty" optional="hide"/>
                <field name="total_actual_qty" optional="hide"/>
                <field name="total_achievement" widget="percentage" optional="hide"/>
                <field name="daily_production_plan"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_annual_production_plan_form" model="ir.ui.view">
        <field name="name">annual.production.plan.form</field>
        <field name="model">annual.production.plan</field>
        <field name="arch" type="xml">
            <form string="Annual Production Plan">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                        modifiers="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-success"
                        modifiers="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_compute_actuals" type="object" string="Compute Actuals" class="btn-info"
                        modifiers="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done" clickable="true"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="planned_by_id"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="daily_production_plan"/>
                        </group>
                    </group>
                    <group string="Summary Totals">
                        <field name="total_planned_qty" readonly="1"/>
                        <field name="total_actual_qty" readonly="1"/>
                        <field name="total_achievement" widget="percentage" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Daily Plan">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="planned_quantity"/>
                                    <field name="actual_quantity"/>
                                    <field name="achievement" widget="percentage"/>
                                    <field name="remark"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_annual_production_plan" model="ir.actions.act_window">
        <field name="name">Annual Production Plans</field>
        <field name="res_model">annual.production.plan</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_annual_production_plan_tree"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_annual_production_plan"
              name="Annual Production Plans"
              parent="mrp.mrp_planning_menu_root"
              action="action_annual_production_plan"/>
</odoo>
